{
  "rewrites": [
    {
      "source": "/confirm/:token",
      "destination": "https://apiv1.travioafrica.com/api/suppliers/settings/notification-recipients/verify?token=:token"
    },
    {
      "source": "/unsubscribe/:id/:token",
      "destination": "https://apiv1.travioafrica.com/api/suppliers/settings/notification-recipients/unsubscribe?id=:id&token=:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
